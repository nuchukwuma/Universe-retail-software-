{
  "name": "universe-pos-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend (Node.js + Express, with its own built-in data files) for the Universe retail POS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "import-mongodb": "node scripts/import-from-mongodb.js"
  },
  "nodemonConfig": {
    "ignore": [
      "data/*",
      "backups/*",
      "uploads/*",
      "logs/*"
    ]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mingo": "6.7.2"
  },
  "devDependencies": {
    "mongodb": "^5.9.2",
    "nodemon": "^3.1.9"
  }
}
