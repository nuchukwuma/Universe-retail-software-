# Settings for DEVELOPMENT (npm run dev). The desktop app does not use
# this file - it creates its own settings on the laptop automatically.
# Copy this file to ".env" and change the values.

# Port the API server listens on
PORT=5000

# MongoDB on this computer (the data never leaves the computer)
MONGO_URI=mongodb://127.0.0.1:27017/universe_pos
# If this is an online address (MongoDB Atlas, mongodb+srv://...), the app
# still saves the shop on this computer: the first time MongoDB is running
# here, it copies everything from the online database once, then uses this
# computer's database. To really use an online database, also set:
# ALLOW_ONLINE_DATABASE=true

# Secret used to sign login tokens. Use a long random string in real use!
JWT_SECRET=change-this-to-a-long-random-secret

# How long a login lasts before the user must log in again
JWT_EXPIRES_IN=12h

# Telegram sales alerts are set up in the app: Settings -> Telegram.
# (TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID here still work as a fallback.)
