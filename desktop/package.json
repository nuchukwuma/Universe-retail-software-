{
  "name": "hordedesk",
  "productName": "HordeDesk",
  "version": "2.0.0",
  "private": true,
  "description": "HordeDesk - shop till, stock and back office (desktop app for Windows)",
  "author": "HordeDesk",
  "main": "main.js",
  "scripts": {
    "copy-app": "node scripts/copy-app.js",
    "build-client": "npm --prefix ../client install && npm --prefix ../client run build",
    "start": "npm run copy-app && electron .",
    "dist": "npm run build-client && npm run copy-app && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mingo": "6.7.2"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.hordedesk.app",
    "productName": "HordeDesk",
    "copyright": "HordeDesk",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "error.html",
      "loading.html",
      "electron/**/*",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HordeDesk",
      "artifactName": "HordeDesk-Setup.exe"
    }
  }
}
