# Copy this file to ".env" and change the values.

# Port the API server listens on
PORT=5000

# MongoDB connection string (local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/universe_pos

# Secret used to sign login tokens. Use a long random string in real use!
JWT_SECRET=change-this-to-a-long-random-secret

# How long a login lasts before the user must log in again
JWT_EXPIRES_IN=12h

# --- Telegram sales alerts (optional) ---
# 1. In Telegram, talk to @BotFather, send /newbot and copy the token it gives you.
# 2. Add the bot to your shop's group (or start a chat with it) and send /start.
# 3. Find the chat id on Settings -> Telegram -> "Find my chat ID" (group ids start with -100).
# Leave these empty to switch Telegram alerts off. Restart the server after changing them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
